-- Signup gate: only emails that hold a pending portal invite may create an account.
-- Service-role created users (admin actions, seed scripts) are exempt.
create or replace function public.enforce_portal_invite()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if auth.role() = 'service_role' then
    return new;
  end if;

  if new.email is not null and exists (
    select 1 from portal_invites
    where lower(email) = lower(new.email) and accepted_at is null
  ) then
    return new;
  end if;

  raise exception 'An invitation is required to create an account. Please use the email address your CityWide account manager invited.'
    using errcode = '42501';
end $$;

 drop trigger if exists enforce_portal_invite on auth.users;
create trigger enforce_portal_invite
before insert on auth.users
for each row execute function public.enforce_portal_invite();