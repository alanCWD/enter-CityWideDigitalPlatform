-- One-round-trip guard for the entitlement API: authenticates the workspace
-- token, resolves the workspace, enforces the hourly limit and logs the request.
-- Errors are logged here too, so every error's requestId exists server-side.
create or replace function public.workspace_api_guard(
  p_token_hash text,
  p_workspace_id text,
  p_request_id text
) returns jsonb
language plpgsql
security definer
set search_path = public, pg_temp
as $$
declare
  v_token_id text;
  v_token_workspace text;
  v_revoked timestamptz;
  v_ws public.workspace_entitlement_workspaces%rowtype;
  v_count int;
  v_oldest timestamptz;
  v_retry int;
  v_entitlements jsonb;
begin
  select id, workspace_id, revoked_at
    into v_token_id, v_token_workspace, v_revoked
    from public.workspace_api_tokens
   where token_hash = p_token_hash
   limit 1;

  if v_token_id is null or v_revoked is not null then
    insert into public.workspace_api_requests (workspace_id, route, status, duration_ms, request_id)
    values (left(p_workspace_id, 120), 'workspaces.entitlements', 401, 0, p_request_id);
    return jsonb_build_object('outcome', 'unauthorized');
  end if;

  select * into v_ws
    from public.workspace_entitlement_workspaces
   where workspace_id = p_workspace_id;

  if v_ws.workspace_id is null then
    insert into public.workspace_api_requests (workspace_id, token_id, route, status, duration_ms, request_id)
    values (left(p_workspace_id, 120), v_token_id, 'workspaces.entitlements', 404, 0, p_request_id);
    return jsonb_build_object('outcome', 'not_found');
  end if;

  if v_token_workspace <> v_ws.workspace_id then
    insert into public.workspace_api_requests (workspace_id, token_id, route, status, duration_ms, request_id)
    values (v_ws.workspace_id, v_token_id, 'workspaces.entitlements', 403, 0, p_request_id);
    return jsonb_build_object('outcome', 'forbidden');
  end if;

  select count(*), min(created_at)
    into v_count, v_oldest
    from public.workspace_api_requests
   where workspace_id = v_ws.workspace_id
     and created_at >= now() - interval '1 hour'
     and status <> 429;

  if v_count >= 30 then
    v_retry := greatest(1, ceil(extract(epoch from (v_oldest + interval '1 hour' - now())))::int);
    insert into public.workspace_api_requests (workspace_id, token_id, route, status, duration_ms, request_id)
    values (v_ws.workspace_id, v_token_id, 'workspaces.entitlements', 429, 0, p_request_id);
    return jsonb_build_object('outcome', 'rate_limited', 'retryAfter', v_retry);
  end if;

  insert into public.workspace_api_requests (workspace_id, token_id, route, status, duration_ms, request_id)
  values (v_ws.workspace_id, v_token_id, 'workspaces.entitlements', 0, 0, p_request_id);

  update public.workspace_api_tokens set last_used_at = now() where id = v_token_id;

  select coalesce(jsonb_object_agg(plan_id, jsonb_build_object(
           'socialStudio', social_studio,
           'maxChannels', max_channels,
           'whiteLabel', white_label,
           'aiMonthlyCapUsd', ai_monthly_cap_usd::float8)), '{}'::jsonb)
    into v_entitlements
    from public.workspace_plan_entitlements;

  return jsonb_build_object(
    'outcome', 'ok',
    'workspace', jsonb_build_object(
      'workspace_id', v_ws.workspace_id,
      'crm_client_id', v_ws.crm_client_id,
      'agency_id', v_ws.agency_id,
      'timezone', v_ws.timezone,
      'gst_rate', v_ws.gst_rate::float8,
      'currency', v_ws.currency),
    'entitlements', v_entitlements);
end $$;

revoke all on function public.workspace_api_guard(text, text, text) from public, anon, authenticated;
grant execute on function public.workspace_api_guard(text, text, text) to service_role;

comment on function public.workspace_api_guard(text, text, text) is 'Auth + workspace + rate limit + request log for the Social Studio entitlement API. Service role only.';

-- Complete member list in one round trip. Members are derived live from CED
-- access data, so a removal in CED disappears from the next snapshot.
create or replace function public.workspace_member_snapshot(
  p_workspace_id text,
  p_client_id text,
  p_connection_id text default null
) returns jsonb
language sql
security definer
set search_path = public, pg_temp
as $$
with candidates as (
  select 'u:' || ur.user_id::text as member_key,
         case when ur.role in ('super_admin', 'admin', 'agency') then 'owner' else 'approver' end as role,
         null::timestamptz as fallback_updated
    from public.user_roles ur
   where ur.role in ('super_admin', 'admin', 'agency', 'agency_staff')
  union all
  select 'u:' || cm.user_id::text,
         case
           when exists (select 1 from public.user_roles r
                         where r.user_id = cm.user_id and r.role = 'client_admin') then 'owner'
           when exists (select 1 from public.user_roles r
                         where r.user_id = cm.user_id and r.role = 'client') then 'approver'
           else 'viewer' end,
         null::timestamptz
    from public.client_memberships cm
   where cm.client_id = p_client_id
  union all
  select 'u:' || pu.user_id::text,
         case
           when lower(coalesce(pu.role, '')) = 'owner' then 'owner'
           when lower(coalesce(pu.role, '')) in ('admin', 'manager', 'staff', 'agent') then 'approver'
           else 'viewer' end,
         pu.created_at
    from public.portal_users pu
   where p_connection_id is not null
     and pu.connection_id = p_connection_id::uuid
),
aggregated as (
  select member_key,
         case max(case role when 'owner' then 3 when 'approver' then 2 else 1 end)
           when 3 then 'owner' when 2 then 'approver' else 'viewer' end as role,
         max(fallback_updated) as fallback_updated
    from candidates
   group by member_key
),
people as (
  select a.member_key, a.role,
         d.email, d.full_name, d.last_sign_in_at, d.banned_until, d.updated_at,
         null::text as invite_status
    from aggregated a
    join public.workspace_member_directory d
      on d.id::text = substr(a.member_key, 3)
),
invited as (
  select 'i:' || i.id as member_key, i.role,
         i.email, i.name as full_name,
         null::timestamptz as last_sign_in_at,
         null::timestamptz as banned_until,
         i.updated_at,
         i.status as invite_status
    from public.workspace_staff_invites i
   where i.workspace_id = p_workspace_id
),
merged as (
  select * from people
  union all
  select * from invited
)
select jsonb_build_object(
  'members', coalesce((
    select jsonb_agg(jsonb_build_object(
             'id', 'usr_' || replace(substr(m.member_key, 3), '-', ''),
             'name', coalesce(nullif(btrim(m.full_name), ''),
                             initcap(replace(split_part(m.email, '@', 1), '.', ' '))),
             'email', m.email,
             'role', m.role,
             'status', case
               when m.banned_until is not null and m.banned_until > now() then 'disabled'
               when m.invite_status is not null then m.invite_status
               when m.last_sign_in_at is not null then 'active'
               else 'invited' end,
             'updatedAt', to_char(coalesce(m.updated_at, now()) at time zone 'UTC',
                                  'YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'))
           order by case m.role when 'owner' then 3 when 'approver' then 2 else 1 end desc,
                    coalesce(m.full_name, m.email) asc)
      from merged m
     where m.email is not null and btrim(m.email) <> ''
  ), '[]'::jsonb),
  'missingEmail', (select count(*) from merged m where m.email is null or btrim(m.email) = '')
);
$$;

revoke all on function public.workspace_member_snapshot(text, text, text) from public, anon, authenticated;
grant execute on function public.workspace_member_snapshot(text, text, text) to service_role;

comment on function public.workspace_member_snapshot(text, text, text) is 'Live CED member list for a studio workspace. Service role only.';