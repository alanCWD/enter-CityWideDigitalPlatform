-- Studio consumer side: the local mirror the CityWide Social Studio keeps of
-- the CED entitlement snapshot. CED stays read-only and authoritative; these
-- tables only ever hold what a 200 response contained.

create table if not exists public.studio_mirror_targets (
  workspace_id text primary key,
  label text not null default '',
  enabled boolean not null default true,
  created_at timestamptz not null default now()
);

comment on table public.studio_mirror_targets is 'Workspaces the studio mirrors from CED. One row per workspace the studio serves.';

insert into public.studio_mirror_targets (workspace_id, label)
values ('ws_citywide', 'CityWide Digital')
on conflict (workspace_id) do nothing;

create table if not exists public.studio_workspace_mirror (
  workspace_id text primary key references public.studio_mirror_targets(workspace_id) on delete cascade,
  schema_version text not null,
  account_id text not null,
  account_name text not null,
  account_status text not null check (account_status in ('active','suspended','closed')),
  billing_email text not null,
  timezone text not null,
  currency text not null,
  plan_id text not null check (plan_id in ('starter','growth','pro')),
  plan_name text not null,
  subscription_status text not null check (subscription_status in ('trialing','active','past_due','paused','canceled')),
  price_cad numeric(12,2) not null default 0,
  gst_rate numeric(6,4) not null default 0,
  current_period_end timestamptz,
  cancel_at_period_end boolean not null default false,
  social_studio boolean not null default false,
  max_channels integer not null default 0 check (max_channels between 0 and 50),
  white_label boolean not null default false,
  ai_monthly_cap_usd numeric(10,2) not null default 0,
  members jsonb not null default '[]'::jsonb,
  etag text,
  source_synced_at timestamptz,
  mirrored_at timestamptz not null default now(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

comment on table public.studio_workspace_mirror is 'Last valid CED snapshot per workspace. Replaced whole on every successful sync.';

create table if not exists public.studio_sync_runs (
  id uuid primary key default gen_random_uuid(),
  workspace_id text,
  status text not null check (status in ('ok','not_modified','error')),
  http_status integer,
  duration_ms integer,
  etag text,
  message text,
  created_at timestamptz not null default now()
);

create index if not exists studio_sync_runs_ws_idx on public.studio_sync_runs (workspace_id, created_at desc);

comment on table public.studio_sync_runs is 'Sync attempts for the studio mirror. Status, duration and a short message only - never a payload or an email address.';

create table if not exists public.studio_internal (
  id integer primary key default 1 check (id = 1),
  scheduler_secret_hash text not null
);

comment on table public.studio_internal is 'Internal studio settings. Holds only the hash of the sync scheduler credential.';

alter table public.studio_mirror_targets enable row level security;
alter table public.studio_workspace_mirror enable row level security;
alter table public.studio_sync_runs enable row level security;
alter table public.studio_internal enable row level security;