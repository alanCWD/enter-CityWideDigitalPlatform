ALTER TYPE public.app_role ADD VALUE IF NOT EXISTS 'agency_staff';
ALTER TYPE public.app_role ADD VALUE IF NOT EXISTS 'client_admin';
ALTER TYPE public.app_role ADD VALUE IF NOT EXISTS 'client_user';

CREATE TABLE IF NOT EXISTS public.client_memberships (
  user_id uuid PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
  client_id text NOT NULL,
  created_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE public.client_memberships ENABLE ROW LEVEL SECURITY;

CREATE POLICY "users read own client membership"
  ON public.client_memberships FOR SELECT
  USING (user_id = auth.uid() OR is_admin());

GRANT SELECT ON public.client_memberships TO authenticated;
REVOKE INSERT, UPDATE, DELETE ON public.client_memberships FROM authenticated, anon;