-- Track the last time we polled each QuickBooks connection for newly-paid invoices,
-- since QuickBooks webhooks cannot reach this platform's backend functions directly
-- (the gateway requires an Authorization header on every inbound request, which
-- Intuit's webhook system has no way to send).
ALTER TABLE quickbooks_connections ADD COLUMN IF NOT EXISTS last_invoice_sync_at timestamptz;

-- Unschedule any prior job with the same name so this migration is safe to re-run
DO $$
BEGIN
  PERFORM cron.unschedule(jobid) FROM cron.job WHERE jobname = 'qbo-poll-invoices-daily';
EXCEPTION WHEN OTHERS THEN NULL;
END $$;

-- Once a day, check every connected QuickBooks company for invoices that were
-- marked paid since the last check, and send review request emails for them.
SELECT cron.schedule(
  'qbo-poll-invoices-daily',
  '0 14 * * *',
  $$
  SELECT net.http_post(
    url := 'https://spb-t4n1w2j9jwhhc7h6.supabase.opentrust.net/functions/v1/qbo-poll-invoices',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
