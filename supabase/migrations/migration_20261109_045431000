-- Lets the signup screen say "no invite" clearly instead of a generic failure.
-- Only the boolean is exposed; invite rows stay private.
create or replace function public.has_portal_invite(_email text)
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from portal_invites
    where lower(email) = lower(coalesce(_email, '')) and accepted_at is null
  );
$$;

grant execute on function public.has_portal_invite(text) to anon, authenticated;