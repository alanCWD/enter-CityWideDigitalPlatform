-- Track connection health so we can detect and notify on QuickBooks token expiry
ALTER TABLE quickbooks_connections ADD COLUMN IF NOT EXISTS status text NOT NULL DEFAULT 'active';
ALTER TABLE quickbooks_connections ADD COLUMN IF NOT EXISTS last_error text;

-- Unschedule any prior job with the same name so this migration is safe to re-run
DO $$
BEGIN
  PERFORM cron.unschedule(jobid) FROM cron.job WHERE jobname = 'qbo-refresh-tokens-daily';
EXCEPTION WHEN OTHERS THEN NULL;
END $$;

-- Proactively refresh every QuickBooks connection's token once a day.
-- QBO refresh tokens are valid ~100 days but get renewed to a fresh 100-day
-- lifespan every time they're used — so a daily refresh keeps active
-- connections alive indefinitely, and immediately surfaces real expirations
-- (revoked access, etc.) instead of waiting for a customer invoice to fail.
