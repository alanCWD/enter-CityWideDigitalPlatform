-- 6) client_leads (connection_id is text here, portal_users is uuid)
 drop policy if exists "service_role_all_cl" on public.client_leads;
create policy "agency manages client_leads" on public.client_leads
for all to authenticated using (public.is_agency()) with check (public.is_agency());

 drop policy if exists "portal users see own client_leads" on public.client_leads;
create policy "portal users see own client_leads" on public.client_leads
for select to authenticated using (
  exists (select 1 from portal_users pu where pu.user_id = auth.uid() and pu.connection_id::text = client_leads.connection_id)
);

 drop policy if exists "portal users insert own client_leads" on public.client_leads;
create policy "portal users insert own client_leads" on public.client_leads
for insert to authenticated with check (
  exists (select 1 from portal_users pu where pu.user_id = auth.uid() and pu.connection_id::text = client_leads.connection_id)
);

 drop policy if exists "portal users update own client_leads" on public.client_leads;
create policy "portal users update own client_leads" on public.client_leads
for update to authenticated using (
  exists (select 1 from portal_users pu where pu.user_id = auth.uid() and pu.connection_id::text = client_leads.connection_id)
) with check (
  exists (select 1 from portal_users pu where pu.user_id = auth.uid() and pu.connection_id::text = client_leads.connection_id)
);

