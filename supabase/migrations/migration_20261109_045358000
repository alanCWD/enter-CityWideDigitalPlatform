-- 13) gbp_connections tokens: rows stay readable for the agency UI, but browser
--     sessions never receive OAuth tokens (portal clients included).
revoke select on public.gbp_connections from anon, authenticated;
grant select (
  id, client_label, business_name, address, phone, website, category, rating,
  review_count, last_synced_at, created_at, agency_id, location_id,
  google_account_id, google_account_name, google_location_name,
  synup_location_id, zernio_profile_id, token_expires_at, google_token_expiry
) on public.gbp_connections to authenticated;