-- 1) Helper: agency staff = admin or agency role (security definer, safe for RLS)
create or replace function public.is_agency()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from user_roles
    where user_id = auth.uid() and role in ('admin'::app_role, 'agency'::app_role)
  );
$$;

grant execute on function public.is_agency() to authenticated, anon;

-- 2) gbp_connections: replace world-writable policy
 drop policy if exists "Allow all for now" on public.gbp_connections;
create policy "agency manages gbp_connections" on public.gbp_connections
for all to authenticated using (public.is_agency()) with check (public.is_agency());

