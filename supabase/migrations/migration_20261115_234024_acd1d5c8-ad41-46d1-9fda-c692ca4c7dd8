CREATE OR REPLACE FUNCTION public.recorder_company_guard()
RETURNS trigger LANGUAGE plpgsql SET search_path = public AS $$
BEGIN
  IF NEW.stable_id IS DISTINCT FROM OLD.stable_id THEN
    RAISE EXCEPTION 'recorder company stable_id cannot change';
  END IF;
  IF NEW.crm_client_id IS DISTINCT FROM OLD.crm_client_id THEN
    RAISE EXCEPTION 'recorder company crm_client_id cannot change';
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS recorder_companies_guard ON public.recorder_companies;
CREATE TRIGGER recorder_companies_guard
  BEFORE UPDATE ON public.recorder_companies
  FOR EACH ROW EXECUTE FUNCTION public.recorder_company_guard();